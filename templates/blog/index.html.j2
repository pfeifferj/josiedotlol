{% extends "_base.html.j2" %}
{% block head %}
    <title>josie.lol - blog</title>

    <meta
      name="description"
      content="blog by josephine pfeiffer on cloud-native tech, infrastructure, security, and developer experience."
    />
    <link rel="canonical" href="{{ site.url }}/blog/" />
    <link rel="alternate" type="application/rss+xml" title="josie.lol blog RSS feed" href="/rss.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="{{ site.url }}/blog/" />
    <meta name="title" property="og:title" content="josie.lol - blog" />
    <meta
      name="description"
      property="og:description"
      content="blog by josephine pfeiffer on cloud-native tech, infrastructure, security, and developer experience."
    />
    <meta name="image" property="og:image" content="{{ site.url }}/screenshot.png" />
    <meta name="author" content="josephine pfeiffer" />

    <meta name="twitter:card" property="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" property="twitter:url" content="{{ site.url }}/blog/" />
    <meta name="twitter:title" property="twitter:title" content="josie.lol - blog" />
    <meta
      name="twitter:description"
      property="twitter:description"
      content="blog by josephine pfeiffer on cloud-native tech, infrastructure, security, and developer experience."
    />
    <meta name="twitter:image" property="twitter:image" content="{{ site.url }}/screenshot.png" />
{% endblock %}
{% block content %}
        <div class="p-2 w-full md:col-span-10 col-span-1 mt-4 mb-1">
          <span class="inline-block px-2 py-1 mb-1 rounded bg-opacity-5 bg-purple-500">❯ ls -la <span class="josie">/blog</span></span>
          <div class="flex items-center justify-between">
            <h1 class="text-xl font-bold">
              <a href="/" class="text-purple-500 dark:text-purple-400 no-underline transition-colors duration-200 hover:text-white hover:underline">
                <span class="josie">josie.lol</span> <span>/</span> blog
              </a>
            </h1>
          </div>
        </div>

        <hr class="border-gray-700 dark:border-gray-600 w-full col-span-full md:col-span-10 mx-0 my-1">

        <div class="p-2 w-full md:col-span-10 col-span-1 mb-1">
          <div class="blog-posts-list pl-2">
{% for post in blog_posts %}
            <div class="py-4 border-b border-gray-700 dark:border-gray-600">
              <p class="text-sm text-gray-500 mb-2">{{ post.date_iso }} &middot; by {{ post.author | lower_keep_acronyms }}{% if post.publication %} &middot; <span class="external-post-badge">Published on {{ post.publication }}</span>{% endif %}</p>
              <h2 class="text-xl mb-2">
{% if post.external %}
                <a href="{{ post.url }}" class="text-purple-500 dark:text-purple-400 no-underline transition-colors duration-200 hover:text-black dark:hover:text-white hover:underline" target="_blank" rel="noopener noreferrer">{{ post.title }} &nearr;</a>
{% else %}
                <a href="{{ post.slug }}.html" class="text-purple-500 dark:text-purple-400 no-underline transition-colors duration-200 hover:text-black dark:hover:text-white hover:underline">{{ post.title }}</a>
{% endif %}
              </h2>
              <p class="text-gray-300 mb-2">{{ post.description }}</p>
{% if post.tags %}
              <div class="flex flex-wrap">
{% for tag in post.tags %}
                <span class="text-xs mr-2 mb-2 px-2 py-1 bg-purple-900 bg-opacity-30 rounded-md">{{ tag }}</span>
{% endfor %}
              </div>
{% endif %}
            </div>
{% endfor %}
          </div>
        </div>
{% endblock %}

    <script>
      // Wait for fonts to load before showing content
      document.fonts.ready.then(() => {
        document.body.classList.add('fonts-loaded');
      });

      const codeLink = document.querySelector(".show-links");
      const hiddenLinks = document.querySelector(".hidden-links");
      let timer;

      codeLink.addEventListener("mouseenter", () => {
        hiddenLinks.style.display = "inline";
        clearTimeout(timer);
      });

      hiddenLinks.addEventListener("mouseenter", () => {
        hiddenLinks.style.display = "inline";
        clearTimeout(timer);
      });

      codeLink.addEventListener("mouseleave", () => {
        timer = setTimeout(() => {
          hiddenLinks.style.display = "none";
        }, 2000); // 2000 milliseconds = 2 seconds
      });

      hiddenLinks.addEventListener("mouseleave", () => {
        timer = setTimeout(() => {
          hiddenLinks.style.display = "none";
        }, 2000); // 2000 milliseconds = 2 seconds
      });

      // Terminal functionality
      document.addEventListener('DOMContentLoaded', () => {
        const terminalInput = document.getElementById('terminal-input');
        const terminalOutput = document.getElementById('terminal-output');

        // Command history functionality
        const commandHistory = [];
        let historyIndex = -1;

        // Autocomplete functionality
        let autocompleteResults = [];
        let autocompleteIndex = -1;
        let autocompleteDiv = null;

        // Define available commands
        const commands = {
          'help': {
            description: 'show available commands',
            action: () => {
              let output = 'available commands:\n\n';
              output += '<div class="grid grid-cols-[minmax(180px,auto)_1fr] gap-2">';
              for (const cmd in commands) {
                // Properly escape the command string for HTML attributes
                const escapedCmd = cmd.replace(/"/g, '&quot;');
                output += `<div><span class="text-purple-500 dark:text-purple-400 cursor-pointer command-link" tabindex="0" role="button" data-command="${escapedCmd}">${cmd}</span></div><div>${commands[cmd].description}</div>`;
              }
              output += '</div>';

              // Add a small delay to ensure the DOM is updated before adding event listeners
              setTimeout(() => {
                // Add click event listeners to all command links
                const commandLinks = document.querySelectorAll('.command-link');
                commandLinks.forEach(link => {
                  // Mouse click handler
                  link.addEventListener('click', () => {
                    executeCommand(link.getAttribute('data-command'));
                  });

                  // Keyboard handler for enter and space
                  link.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter' || e.key === ' ') {
                      e.preventDefault();
                      executeCommand(link.getAttribute('data-command'));
                    }
                  });
                });
              }, 100);

              return output;
            }
          },
          'ls -la /crt/': {
            description: 'show certifications',
            action: () => {
              document.getElementById('section-certs').classList.remove('hidden');
              document.getElementById('hr-certs').classList.remove('hidden');
              return 'showing certifications section';
            }
          },
          'grep "volunteer" ~/.profile': {
            description: 'show volunteer experience',
            action: () => {
              document.getElementById('section-volunteer').classList.remove('hidden');
              document.getElementById('hr-volunteer').classList.remove('hidden');
              return 'showing volunteer experience';
            }
          },
          'clear': {
            description: 'clear terminal output',
            action: () => {
              // Clear terminal output
              terminalOutput.innerHTML = '';
              terminalInput.value = '';

              // Hide all sections that might have been revealed
              document.getElementById('section-certs').classList.add('hidden');
              document.getElementById('hr-certs').classList.add('hidden');
              document.getElementById('section-volunteer').classList.add('hidden');
              document.getElementById('hr-volunteer').classList.add('hidden');

              return '';
            }
          }
        };

        // Enhanced command matching with autocomplete support
        function findCommand(input) {
          // Clean the input by trimming whitespace
          const cleanInput = input.trim();

          // Exact match - check the exact command string
          if (commands[cleanInput]) return commands[cleanInput];

          // Partial matches - allow for command variations
          if (cleanInput.startsWith('ls -la /crt')) return commands['ls -la /crt/'];
          if (cleanInput.match(/^grep\s+["']?volunteer["']?/i)) return commands['grep "volunteer" ~/.profile'];
          if (cleanInput.startsWith('tree /talks')) return commands['tree /talks'];
          if (cleanInput.startsWith('rssfetch')) return commands['rssfetch rss.xml'];

          return null;
        }

        // Function to generate autocomplete suggestions
        function generateAutocomplete(input) {
          if (!input) return [];
          const commandNames = Object.keys(commands);
          return commandNames.filter(cmd => cmd.startsWith(input) && cmd !== input);
        }

        // Function to show autocomplete suggestions
        function showAutocompleteSuggestions(suggestions) {
          // Remove existing autocomplete div if it exists
          if (autocompleteDiv) {
            autocompleteDiv.remove();
            autocompleteDiv = null;
          }

          if (suggestions.length === 0) {
            autocompleteIndex = -1;
            return;
          }

          // Create new autocomplete div
          autocompleteDiv = document.createElement('div');
          autocompleteDiv.classList.add('autocomplete-container', 'absolute', 'z-10', 'bg-[rgba(18,18,18,0.9)]', 'border', 'border-purple-500', 'rounded', 'mt-2', 'max-h-[150px]', 'overflow-y-auto', 'min-w-[200px]');

          // Add suggestions to autocomplete div
          const fragment = document.createDocumentFragment();
          suggestions.forEach((suggestion, index) => {
            const item = document.createElement('div');
            item.classList.add('autocomplete-item', 'p-2', 'cursor-pointer', 'font-mono', 'text-sm');
            item.textContent = suggestion;

            // Highlight item when hovered
            item.addEventListener('mouseenter', () => {
              autocompleteIndex = index;
              updateSelectedAutocomplete();
            });

            // Select item when clicked
            item.addEventListener('click', () => {
              terminalInput.value = suggestion;
              hideAutocompleteSuggestions();
              terminalInput.focus();
            });

            fragment.appendChild(item);
          });

          autocompleteDiv.appendChild(fragment);

          // Position the autocomplete div below the input
          // Get the terminal input's position relative to the viewport
          const inputRect = terminalInput.getBoundingClientRect();
          const inputParent = terminalInput.parentElement;
          const parentRect = inputParent.getBoundingClientRect();

          // Position the autocomplete to align with the input text (accounting for the prompt)
          autocompleteDiv.style.position = 'fixed';
          autocompleteDiv.style.left = `${inputRect.left}px`;
          autocompleteDiv.style.top = `${inputRect.bottom + 8}px`; // 8px gap below input
          autocompleteDiv.style.width = `${inputRect.width}px`;

          document.body.appendChild(autocompleteDiv);

          // Set initial selection
          autocompleteIndex = 0;
          updateSelectedAutocomplete();
        }

        // Function to update the selected autocomplete item
        function updateSelectedAutocomplete() {
          if (!autocompleteDiv) return;

          const items = autocompleteDiv.querySelectorAll('.autocomplete-item');

          // Reset all items
          items.forEach(item => {
            item.classList.remove('bg-purple-500', 'text-gray-900');
          });

          // Highlight selected item
          if (autocompleteIndex >= 0 && autocompleteIndex < items.length) {
            items[autocompleteIndex].classList.add('bg-purple-500', 'text-gray-900');
          }
        }

        // Function to hide autocomplete suggestions
        function hideAutocompleteSuggestions() {
          if (autocompleteDiv) {
            autocompleteDiv.remove();
            autocompleteDiv = null;
          }
          autocompleteResults = [];
          autocompleteIndex = -1;
        }

        // Handle input changes for real-time autocompletion - use debouncing
        let debounceTimer;
        terminalInput.addEventListener('input', () => {
          clearTimeout(debounceTimer);
          debounceTimer = setTimeout(() => {
            const input = terminalInput.value.trim();
            autocompleteResults = generateAutocomplete(input);

            if (autocompleteResults.length > 0) {
              showAutocompleteSuggestions(autocompleteResults);
            } else {
              hideAutocompleteSuggestions();
            }
          }, 50);
        });

        // Function to style terminal links
        function styleTerminalLinks() {
          // Get all links in the terminal output (only standard <a> tags, not command links)
          const links = terminalOutput.querySelectorAll('a:not(.command-link)');

          // Apply Tailwind classes to each link
          links.forEach(link => {
            // Add Tailwind classes
            link.classList.add('text-purple-500', 'dark:text-purple-400', 'no-underline', 'transition-colors', 'duration-200', 'hover:text-black', 'dark:hover:text-white', 'hover:underline');
          });

          // Make sure command links in the terminal output have the necessary event listeners
          const commandLinks = terminalOutput.querySelectorAll('.command-link');
          commandLinks.forEach(link => {
            // Event delegation to handle clicks
            link.addEventListener('click', handleCommandLinkClick);
            link.addEventListener('keydown', handleCommandLinkKeydown);
          });
        }

        // Event handlers as separate functions to reduce duplicate code
        function handleCommandLinkClick(e) {
          const command = e.currentTarget.getAttribute('data-command');
          if (command) {
            executeCommand(command);
          }
        }

        function handleCommandLinkKeydown(e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            const command = e.currentTarget.getAttribute('data-command');
            if (command) {
              executeCommand(command);
            }
          }
        }

        // Handle terminal input
        terminalInput.addEventListener('keydown', handleTerminalKeydown);

        function handleTerminalKeydown(e) {
          // Handle autocomplete navigation with up/down arrows when autocomplete is active
          if (autocompleteDiv && (e.key === 'ArrowUp' || e.key === 'ArrowDown')) {
            e.preventDefault();

            if (e.key === 'ArrowUp') {
              autocompleteIndex = Math.max(0, autocompleteIndex - 1);
            } else if (e.key === 'ArrowDown') {
              autocompleteIndex = Math.min(autocompleteResults.length - 1, autocompleteIndex + 1);
            }

            updateSelectedAutocomplete();
            return;
          }

          // Apply autocomplete selection with Tab
          if (e.key === 'Tab' && autocompleteDiv) {
            e.preventDefault();

            if (autocompleteIndex >= 0 && autocompleteIndex < autocompleteResults.length) {
              terminalInput.value = autocompleteResults[autocompleteIndex];
              hideAutocompleteSuggestions();
            }

            return;
          }

          // Handle Enter key to execute command
          if (e.key === 'Enter') {
            e.preventDefault();
            hideAutocompleteSuggestions();

            const input = terminalInput.value.trim();

            // Add to command history if not empty
            if (input) {
              commandHistory.push(input);
              historyIndex = commandHistory.length;
            }

            // Special handling for clear command
            if (input.toLowerCase() === 'clear') {
              terminalOutput.innerHTML = '';
              terminalInput.value = '';

              // Hide all sections that might have been revealed
              document.getElementById('section-certs').classList.add('hidden');
              document.getElementById('hr-certs').classList.add('hidden');
              document.getElementById('section-volunteer').classList.add('hidden');
              document.getElementById('hr-volunteer').classList.add('hidden');

              return;
            }

            // Process command
            executeCommand(input);
          }
          // Handle history navigation with up/down when autocomplete is not active
          else if (!autocompleteDiv && e.key === 'ArrowUp') {
            e.preventDefault();
            if (historyIndex > 0) {
              historyIndex--;
              terminalInput.value = commandHistory[historyIndex];
              // Move cursor to end of input
              setTimeout(() => {
                terminalInput.selectionStart = terminalInput.selectionEnd = terminalInput.value.length;
              }, 0);
            }
          }
          else if (!autocompleteDiv && e.key === 'ArrowDown') {
            e.preventDefault();
            if (historyIndex < commandHistory.length - 1) {
              historyIndex++;
              terminalInput.value = commandHistory[historyIndex];
            } else {
              historyIndex = commandHistory.length;
              terminalInput.value = '';
            }
          }
          // Close autocomplete on Escape
          else if (e.key === 'Escape' && autocompleteDiv) {
            e.preventDefault();
            hideAutocompleteSuggestions();
          }
        }

        // HTML-escape arbitrary text via a detached node; safe for echo
        // back of user-typed (or URL-supplied) input inside innerHTML strings.
        function escapeHtml(s) {
          const d = document.createElement('div');
          d.textContent = s;
          return d.innerHTML;
        }

        // Function to execute a command
        function executeCommand(commandInput) {
          const input = commandInput.trim();

          // Clear previous output
          terminalOutput.innerHTML = '';

          // Echo the prompt + user input. Use DOM construction (not innerHTML)
          // so a payload like `?cmd=<img onerror=...>` renders as literal text.
          const commandElement = document.createElement('div');
          commandElement.classList.add('mb-1');
          const promptSpan = document.createElement('span');
          promptSpan.className = 'text-purple-500';
          promptSpan.textContent = '❯';
          commandElement.appendChild(promptSpan);
          commandElement.appendChild(document.createTextNode(' '));
          const inputSpan = document.createElement('span');
          inputSpan.textContent = input;
          commandElement.appendChild(inputSpan);
          terminalOutput.appendChild(commandElement);

          // Process command
          const command = findCommand(input);
          let response = '';

          if (command) {
            response = command.action();
          } else if (input) {
            response = `command not found: ${escapeHtml(input)}\ntype 'help' for available commands.`;
          }

          // Add response to output if any
          if (response) {
            const responseElement = document.createElement('div');
            responseElement.classList.add('pl-4', 'mb-2', 'whitespace-pre-line');
            responseElement.innerHTML = response;
            terminalOutput.appendChild(responseElement);

            // Style any links that might have been added
            styleTerminalLinks();
          }

          // Clear input and scroll to bottom
          terminalInput.value = '';
          terminalOutput.scrollTop = terminalOutput.scrollHeight;
        }

        // Hide autocomplete when clicking outside
        document.addEventListener('click', (e) => {
          if (autocompleteDiv && !autocompleteDiv.contains(e.target) && e.target !== terminalInput) {
            hideAutocompleteSuggestions();
          }
        });

        // Auto-focus terminal input on page load with small delay to ensure DOM is ready
        requestAnimationFrame(() => {
          terminalInput.focus();
        });

        // Click handler for the page to focus terminal
        document.addEventListener('click', () => {
          terminalInput.focus();
        });

        // Deep-link via ?cmd=<command>: auto-run on load, suppress the welcome.
        // URLSearchParams handles + and percent decoding, so both
        // ?cmd=ls+-la+/crt/ and ?cmd=ls%20-la%20%2Fcrt%2F resolve to the same
        // string. Unknown values fall through to "command not found".
        const initialCmd = new URLSearchParams(window.location.search).get('cmd');
        if (initialCmd && initialCmd.trim()) {
          executeCommand(initialCmd);
        } else {
          setTimeout(() => {
            const welcomeElement = document.createElement('div');
            welcomeElement.classList.add('pl-4', 'mb-2', 'whitespace-pre-line');
            welcomeElement.innerHTML = `welcome to josie.lol terminal!<br /><span class="text-purple-500 dark:text-purple-400">type 'help' to see available commands.<br/>press tab to autocomplete.</span>`;
            terminalOutput.appendChild(welcomeElement);
            styleTerminalLinks();
          }, 100);
        }
      });
    </script>

    <!-- Service Worker Registration -->
    <script>
      // Register service worker only if it's supported - defer execution
      if ('serviceWorker' in navigator) {
        // Use requestIdleCallback or setTimeout to defer non-essential work
        const registerSW = () => {
          navigator.serviceWorker.register('/sw.js')
            .then(registration => {
              console.log('ServiceWorker registration successful with scope: ', registration.scope);
            })
            .catch(error => {
              console.log('ServiceWorker registration failed: ', error);
            });
        };

        if ('requestIdleCallback' in window) {
          window.requestIdleCallback(registerSW);
        } else {
          window.addEventListener('load', () => {
            setTimeout(registerSW, 1000);
          });
        }
      }
    </script>
  </body>
</html>

{% extends "_base.html.j2" %}
{% block head %}
    <title>josie.lol - talks</title>

    <meta
      name="description"
      content="conference talks and presentations by josephine pfeiffer on cloud-native tech, infrastructure, security, and developer experience."
    />
    <link rel="canonical" href="{{ site.url }}/talks/" />
    <link rel="alternate" type="application/rss+xml" title="josie.lol blog RSS feed" href="/rss.xml" />

    <script type="application/ld+json">
{{ talks_jsonld | tojson_ld | safe }}
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:url" content="{{ site.url }}/talks/" />
    <meta name="title" property="og:title" content="josie.lol - talks" />
    <meta
      name="description"
      property="og:description"
      content="conference talks and presentations by josephine pfeiffer on cloud-native tech, infrastructure, security, and developer experience."
    />
    <meta name="image" property="og:image" content="{{ site.url }}/screenshot.png" />
    <meta name="author" content="josephine pfeiffer" />

    <meta name="twitter:card" property="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" property="twitter:url" content="{{ site.url }}/talks/" />
    <meta name="twitter:title" property="twitter:title" content="josie.lol - talks" />
    <meta
      name="twitter:description"
      property="twitter:description"
      content="conference talks and presentations by josephine pfeiffer on cloud-native tech, infrastructure, security, and developer experience."
    />
    <meta name="twitter:image" property="twitter:image" content="{{ site.url }}/screenshot.png" />
{% endblock %}
{% block content %}
        <div class="p-2 w-full md:col-span-10 col-span-1 mt-4 mb-1">
          <span class="inline-block px-2 py-1 mb-1 rounded bg-opacity-5 bg-purple-500">❯ ls -la <span class="josie">/talks</span></span>
          <div class="flex items-center justify-between">
            <h1 class="text-xl font-bold">
              <a href="/" class="text-purple-500 dark:text-purple-400 no-underline transition-colors duration-200 hover:text-white hover:underline">
                <span class="josie">josie.lol</span> <span>/</span> talks
              </a>
            </h1>
          </div>
        </div>

        <hr class="border-gray-700 dark:border-gray-600 w-full col-span-full md:col-span-10 mx-0 my-1">

        <div class="p-2 w-full md:col-span-10 col-span-1 mb-1">
{% macro talk_card(t) %}
            <div class="py-6 border-b border-gray-700 dark:border-gray-600">
              <h2 class="text-xl font-bold mb-2 text-purple-400">{{ t.title }}</h2>
              <p class="text-gray-300 mb-4">{{ t.abstract }}</p>
{% if t.related_post %}
              <p class="mb-4"><a href="{{ t.related_post }}" class="text-purple-500 dark:text-purple-400 no-underline transition-colors duration-200 hover:text-white hover:underline">Read related blog post</a></p>
{% endif %}
              <div class="text-base text-gray-400">
                <p class="mb-2 font-bold">{{ "presenting at:" if t.upcoming else "presented at:" }}</p>
{% for c in t.conferences %}
                <div class="mb-3">
{% if c.cancelled %}
                  <div class="font-semibold line-through opacity-50">{{ c.name }}</div>
                  <div class="text-sm text-gray-500 line-through opacity-50">{{ c.location }} ({{ c.date }})</div>
                  <div class="text-sm text-gray-500 italic">cancelled</div>
{% else %}
                  <div class="font-semibold">{{ c.name }}</div>
                  <div class="text-sm text-gray-500">{{ c.location }} ({{ c.date }})</div>
{% if c.slides or c.recording %}
                  <div class="mt-1">
{% if c.slides %}
                    <a href="{{ c.slides }}" class="text-purple-500 dark:text-purple-400 mr-3 text-sm no-underline transition-colors duration-200 hover:text-white hover:underline">slides</a>
{% endif %}
{% if c.recording %}
                    <a href="{{ c.recording }}" class="text-purple-500 dark:text-purple-400 text-sm no-underline transition-colors duration-200 hover:text-white hover:underline">recording</a>
{% endif %}
                  </div>
{% endif %}
{% endif %}
                </div>
{% endfor %}
              </div>
            </div>
{% endmacro %}
{% set upcoming = talks | selectattr("upcoming") | list %}
{% set past = talks | rejectattr("upcoming") | list %}
{% if upcoming %}
          <p class="mb-1 px-2 text-sm uppercase tracking-wide text-purple-400">upcoming</p>
          <div class="talks-list pl-2 mb-6">
{% for t in upcoming %}{{ talk_card(t) }}{% endfor %}
          </div>
{% endif %}
{% if past %}
          <p class="mb-1 px-2 text-sm uppercase tracking-wide text-gray-500">past</p>
{% endif %}
          <div class="talks-list pl-2">
{% for t in past %}{{ talk_card(t) }}{% endfor %}
          </div>
        </div>
{% endblock %}
